# Configuração opcional. O endereço abaixo já é o padrão.
ARK_OLLAMA_URL=http://127.0.0.1:11434
# Para fixar um modelo, use o nome exato mostrado em ollama list.
# ARK_OLLAMA_MODEL=llama3.1:8b

# Hospedagem privada: no Render estes valores são configurados pelo render.yaml.
# Em produção, o servidor exige a senha por padrão. Não versione a senha real.
# ARK_REQUIRE_ACCESS=true
# ARK_ACCESS_USER=ark
# ARK_ACCESS_PASSWORD=<senha gerada com pelo menos 16 caracteres>
